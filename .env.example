# Use fake locally; smoke requires live.
BRANE_MODE=fake
# BRANE API base URL; endpoint paths are relative to this URL.
BRANE_BASE_URL=https://brane.ai-z.io/api/v1
# Optional BRANE bearer token; never commit a real token.
BRANE_API_KEY=

# BRANE cloud model (auto uses the configured cloud model).
BRANE_MODEL=auto
# BRANE local model on the same chat-completions endpoint.
BRANE_LOCAL_MODEL=vllm:deepseek-v4.1-flash
# Keep local payload checks enabled.
PRESCRUB=on
# Team and policy version printed in evidence rows.
TEAM_BUILD="UpSolve / policy-v1"
